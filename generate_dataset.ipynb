        "# Generate and Save Datasets\n",
        "\n",
        "import os\n",
        "import pandas as pd\n",
        "\n",
        "os.makedirs(\"./data/baseline\", exist_ok=True)\n",
        "os.makedirs(\"./data/main\",     exist_ok=True)\n",
        "\n",
        "# Baseline: Case Marking\n",
        "case_phenomenon = CaseMarkingPhenomenon()\n",
        "case_batches    = case_phenomenon.generate_batches()\n",
        "\n",
        "case_rows = []\n",
        "for batch in case_batches:\n",
        "    for item in batch.items:\n",
        "        case_rows.append({\n",
        "            \"sentence\":  item.sentence,\n",
        "            \"condition\": item.condition\n",
        "        })\n",
        "\n",
        "df_case = pd.DataFrame(case_rows)\n",
        "df_case.to_csv(\"./data/baseline/case_marking.csv\", index=False, encoding=\"utf-8-sig\")\n",
        "print(f\"Saved case_marking.csv  ({len(df_case)} sentences)\")\n",
        "\n",
        "# Main: Honorific Agreement\n",
        "hon_phenomenon = HonorificPhenomenon()\n",
        "hon_batches    = hon_phenomenon.generate_batches()\n",
        "\n",
        "hon_rows = []\n",
        "for batch in hon_batches:\n",
        "    for item in batch.items:\n",
        "        hon_rows.append({\n",
        "            \"sentence\":  item.sentence,\n",
        "            \"condition\": item.condition\n",
        "        })\n",
        "\n",
        "df_hon = pd.DataFrame(hon_rows)\n",
        "df_hon.to_csv(\"./data/main/honorific.csv\", index=False, encoding=\"utf-8-sig\")\n",
        "print(f\"Saved honorific.csv     ({len(df_hon)} sentences)")"
      ]
    }
